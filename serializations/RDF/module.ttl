                          rdfs:comment "Ownership of an [Instrument Instance](../entities/Instrument_Instance.md)."@en ;
                          rdfs:label "Infrastructure Ownership"@en .


###  https://w3id.org/cerif2/instruments/Instrument_Instance
:Instrument_Instance rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/cerif2/Infrastructure> ;
                     rdfs:comment "A particular device or tool used for scientific purposes, including the study of both natural phenomena and theoretical research.<sup>[1](#fn1)</sup>"@en ;
                     rdfs:label "Instrument Instance"@en .


###  https://w3id.org/cerif2/instruments/Instrument_Instance_Identifier
:Instrument_Instance_Identifier rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/cerif2/Resource_Identifier> ;
                                rdfs:comment "An identifier other than a PID that identifies an [Instrument Instance](../entities/Instrument_Instance.md)."@en ;
                                rdfs:label "Instrument Instance Identifier"@en .


###  https://w3id.org/cerif2/instruments/Instrument_Model
:Instrument_Model rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/cerif2/Infrastructure> ;
                  rdfs:comment "A model of a device or tool used for scientific purposes, including the study of both natural phenomena and theoretical research.<sup>[1](#fn1)</sup>"@en ;
                  rdfs:label "Instrument Model"@en .


###  https://w3id.org/cerif2/instruments/Instrument_Model_Identifier
:Instrument_Model_Identifier rdf:type owl:Class ;
                             rdfs:subClassOf <https://w3id.org/cerif2/Resource_Identifier> ;
                             rdfs:comment "An identifier used to identify an [Instrument Model](../entities/Instrument_Model.md)."@en ;
                             rdfs:label "Instrument Model Identifier"@en .


###  https://w3id.org/cerif2/instruments/Instrument_Model_Type
:Instrument_Model_Type rdf:type owl:Class ;
                       rdfs:comment "The type of instrument model."@en ;
                       rdfs:label "Instrument Model Type"@en .


###  https://w3id.org/cerif2/instruments/Inventory_Number
:Inventory_Number rdf:type owl:Class ;
                  rdfs:subClassOf :Instrument_Instance_Identifier ;
                  rdfs:comment "An inventory number assigned to an [Instrument Instance](../entities/Instrument_Instance.md) by its owner or operator."@en ;
                  rdfs:label "Inventory Number"@en .


###  https://w3id.org/cerif2/instruments/Manufacturing
:Manufacturing rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/cerif2/Contribution_to_Infrastructure> ;
               rdfs:comment "The fact of producing a specific [Instrument Model](../entities/Instrument_Model.md) or even a particular [Instrument Instance](../entities/Instrument_Instance.md)."@en ;
               rdfs:label "Manufacturing"@en .


###  https://w3id.org/cerif2/instruments/Other_Instrument_Instance_Identifier
:Other_Instrument_Instance_Identifier rdf:type owl:Class ;
                                      rdfs:subClassOf :Instrument_Instance_Identifier ;
                                      rdfs:comment "Any other identifier pertaining to an [Instrument Instance](../entities/Instrument_Instance.md), for instance an entry in some instrument database."@en ;
                                      rdfs:label "Other Instrument Instance Identifier"@en .


###  https://w3id.org/cerif2/instruments/Serial_Number
:Serial_Number rdf:type owl:Class ;
               rdfs:subClassOf :Instrument_Instance_Identifier ;
               rdfs:comment "A serial number assigned to an [Instrument Instance](../entities/Instrument_Instance.md), typically by the manufacturer."@en ;
               rdfs:label "Serial Number"@en .


